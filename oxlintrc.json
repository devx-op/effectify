{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist",
    "**/build",
    "**/docs",
    "**/.tsbuildinfo",
    "!scratchpad/**/*",
    ".agents/**/*",
    ".effect-reference/**/*"
  ],
  "overrides": [
    {
      "files": [
        "**/{test,dtslint,examples,benchmark,bundle,scripts,scratchpad}/**"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ]
}
