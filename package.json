{
  "name": "@effectify/repo",
  "version": "1.0.0",
  "license": "MIT",
  "nx": {
    "targets": {
      "format": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/format-changed.mjs --write"
        }
      },
      "format:check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node tools/format-changed.mjs --check"
        }
      },
      "format:all:check": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec oxfmt --check '**/*.{ts,tsx,js,jsx,json,jsonc,md,mdx,css,scss,html}'"
        }
      }
    }
  },
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "lint-staged": "lint-staged --allow-empty",
    "clean": "rm -rf node_modules dist pnpm-lock.yaml && pnpm store prune & find . -type d \\( -name 'node_modules' -o -name 'dist' -o -name '.output' -o -name '.vinxi' -o -name '.cache' -o -name '.expo' -o -name '.nx' \\) -prune -exec rm -rf {} + & wait",
    "prepare": "husky && ts-patch install -s && effect-tsgo patch",
    "build:affected": "pnpm nx affected --target=build",
    "test:affected": "pnpm nx affected --target=test",
    "typecheck:affected": "pnpm nx affected --target=typecheck",
    "format": "pnpm nx run @effectify/repo:format",
    "format:check": "pnpm nx run @effectify/repo:format:check",
    "format:all:check": "pnpm nx run @effectify/repo:format:all:check",
    "lint": "pnpm exec oxlint && pnpm format:check",
    "lint:fix": "pnpm exec oxlint --fix && pnpm format",
    "lint:affected": "pnpm nx affected --target=lint",
    "lint:many": "pnpm nx run-many --target=lint && pnpm format:check",
    "publish:affected": "pnpm nx publish-affected",
    "release:affected": "pnpm nx release-affected",
    "release:affected:dry-run": "pnpm nx release-affected-dry-run"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm exec oxlint --fix",
      "pnpm exec oxfmt"
    ],
    "*.{json,jsonc,md,mdx,css,scss,html}": [
      "pnpm exec oxfmt"
    ]
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@nx/cypress": "catalog:",
    "@nx/js": "catalog:",
    "@nx/node": "catalog:",
    "@nx/react": "catalog:",
    "@nx/vite": "catalog:",
    "@nx/vitest": "23.1.0",
    "@nx/web": "catalog:",
    "@react-router/dev": "8.3.0",
    "@swc-node/register": "catalog:",
    "@swc/core": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "cypress": "catalog:",
    "husky": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "nx": "23.1.0",
    "nx-oxlint": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "ts-patch": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "verdaccio": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "packageExtensions": {
      "starlight-sidebar-topics": {
        "peerDependencies": {
          "astro": "*"
        }
      },
      "@astrojs/mdx": {
        "dependencies": {
          "satteri": "^0.10.3"
        }
      },
      "better-auth": {
        "dependencies": {
          "zod": "^4.4.3"
        }
      },
      "@effect/vitest": {
        "dependencies": {
          "@vitest/runner": "4.1.10"
        }
      }
    },
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "cacache>tar": "7.5.21"
    },
    "onlyBuiltDependencies": [
      "@hatchet-dev/typescript-sdk",
      "@parcel/watcher",
      "@swc/core",
      "@tailwindcss/oxide",
      "better-sqlite3",
      "core-js",
      "cypress",
      "esbuild",
      "msgpackr-extract",
      "nx",
      "protobufjs",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "bun"
    ]
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@prisma/client": "catalog:",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "isbot": "catalog:",
    "prisma": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  }
}
