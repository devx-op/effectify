{
  "name": "@effectify/app-builder-generation",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/app-builder/generation/src",
  "projectType": "library",
  "tags": ["app-builder", "layer:planning", "npm:public"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/app-builder/generation/src/index.ts",
        "tsConfig": "packages/app-builder/generation/tsconfig.lib.json",
        "outputPath": "packages/app-builder/generation/dist",
        "assets": [
          {
            "input": "packages/app-builder/generation/src/templates/assets",
            "glob": "**/*",
            "output": "src/templates/assets"
          }
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
        "cwd": "packages/app-builder/generation"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "../../../node_modules/.bin/vitest run --config vitest.config.mts",
        "cwd": "packages/app-builder/generation"
      }
    },
    "lint": {
      "executor": "nx-oxlint:lint",
      "options": { "lintFilePatterns": ["packages/app-builder/generation/**/*.{ts,mts}"] }
    }
  }
}
