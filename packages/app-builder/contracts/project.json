{
  "name": "@effectify/app-builder-contracts",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/app-builder/contracts/src",
  "projectType": "library",
  "tags": ["app-builder", "public", "contracts"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "packages/app-builder/contracts/src/index.ts",
        "tsConfig": "packages/app-builder/contracts/tsconfig.lib.json",
        "outputPath": "packages/app-builder/contracts/dist"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json",
        "cwd": "packages/app-builder/contracts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../../node_modules/.bin/vitest run --config vitest.config.mts",
        "cwd": "packages/app-builder/contracts"
      }
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "../../../node_modules/.bin/vitest run --config vitest.config.mts --coverage",
        "cwd": "packages/app-builder/contracts"
      }
    },
    "lint": {
      "executor": "nx-oxlint:lint",
      "options": {
        "lintFilePatterns": ["packages/app-builder/contracts/**/*.{ts,mts}"]
      }
    }
  }
}
