{
  "name": "@effectify/react-router-better-auth",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/react/router-better-auth/src",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run --config vitest.config.ts",
        "cwd": "packages/react/router-better-auth"
      }
    },
    "typecheck:no-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project tsconfig.no-build.json --noEmit",
        "cwd": "packages/react/router-better-auth"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --build tsconfig.lib.json",
        "cwd": "packages/react/router-better-auth"
      }
    },
    "lint": {
      "executor": "nx-oxlint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/react/router-better-auth/**/*.{ts,tsx,js,jsx}"]
      }
    }
  },
  "tags": ["node", "react", "react-router", "better-auth", "effect"]
}
