{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist/out-tsc",
    "types": ["vitest/globals", "node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@prisma/client": ["./prisma/generated/client.d.ts"],
      "@prisma/effect": ["./prisma/generated/effect/index.ts"],
      "@prisma/effect/*": ["./prisma/generated/effect/*"],
      "@prisma/*": ["./prisma/generated/*"],
      "@effectify/prisma": ["./src/runtime/index.ts"]
    },
    "rootDir": "."
  },
  "include": ["test/**/*.ts", "src/**/*.ts", "prisma/generated/**/*.ts"]
}
