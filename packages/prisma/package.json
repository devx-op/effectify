{
  "name": "@effectify/prisma",
  "version": "1.1.15",
  "description": "Prisma generator and runtime utilities for Effect",
  "repository": {
    "type": "git",
    "url": "https://github.com/devx-op/effectify",
    "directory": "packages/prisma"
  },
  "main": "./dist/src/runtime/index.js",
  "module": "./dist/src/runtime/index.js",
  "types": "./dist/src/runtime/index.d.ts",
  "type": "module",
  "license": "MIT",
  "bin": {
    "effect-prisma": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/runtime/index.d.ts",
      "import": "./dist/src/runtime/index.js",
      "default": "./dist/src/runtime/index.js"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "import": "./dist/src/cli.js",
      "default": "./dist/src/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prisma:generate": "pnpm exec prisma generate",
    "build": "effect-build",
    "test": "vitest",
    "dev": "tsx src/messaround.ts",
    "cli": "pnpm dlx tsx src/cli.ts"
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@prisma/generator-helper": "catalog:",
    "eta": "catalog:",
    "kysely": "catalog:",
    "oxfmt": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:",
    "@prisma/client": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/build-utils": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@prisma/adapter-better-sqlite3": "catalog:",
    "@prisma/client-runtime-utils": "catalog:",
    "@prisma/generator": "catalog:",
    "@prisma/internals": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "better-sqlite3": "catalog:",
    "bun": "1.3.0",
    "oxlint": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
