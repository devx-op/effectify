{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vitest/globals", "node"]
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "src/**/*.tsx"]
}
