{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "off",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "examples/app-builder-todo/**",
    "**/dist/**",
    "**/build/**",
    "**/.nx/**",
    "**/node_modules/**",
    "**/coverage/**",
    "**/.verdaccio/**",
    "**/.vscode/**",
    "**/.trae/**",
    "**/.husky/**",
    "**/public/**",
    "**/storybook-static/**",
    "**/migrations.json",
    "**/pnpm-lock.yaml",
    "**/tsconfig.tsbuildinfo",
    "**/sqlite.db",
    "**/docker-compose.yml",
    "**/routeTree.gen.ts",
    "**/*.{less,vue,svelte,astro,yaml,yml,toml,graphql,gql,eta}"
  ]
}
