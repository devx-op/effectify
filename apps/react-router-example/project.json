{
  "name": "@effectify/react-router-example",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/react-router-example/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project react-router-example --web",
  "targets": {
    "migration:manifest": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/verify-react-router-manifests.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "migration:verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/verify-react-router-readiness.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "consolidation:verify": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/verify-react-router-consolidation.mjs --expect=retired",
        "cwd": "{workspaceRoot}"
      }
    },
    "migration:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run tests/react-router-readiness.test.ts --config vitest.config.ts",
        "cwd": "apps/react-router-example"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma:generate"],
      "options": {
        "command": "vitest run",
        "cwd": "apps/react-router-example"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc",
        "cwd": "apps/react-router-example"
      },
      "dependsOn": ["typegen", "prisma:generate"]
    },
    "typegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "react-router typegen",
        "cwd": "apps/react-router-example"
      }
    },
    "prisma:generate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build",
          "projects": ["@effectify/prisma"]
        }
      ],
      "options": {
        "command": "pnpm exec prisma generate",
        "cwd": "apps/react-router-example"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "PORT={args.port} react-router-serve build/server/index.js",
        "cwd": "apps/react-router-example",
        "port": 3100,
        "readyWhen": "[react-router-serve] http://localhost:3100",
        "forwardAllArgs": false
      }
    },
    "build": {
      "executor": "nx:run-script",
      "outputs": ["{projectRoot}/build"],
      "options": {
        "script": "build"
      },
      "dependsOn": ["typegen", "prisma:generate", "^build"]
    }
  }
}
