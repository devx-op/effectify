{
  "name": "@effectify/react-remix-example",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/react-remix-example/src",
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "outputs": ["{projectRoot}/build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "dependsOn": ["typegen", "^build"],
      "options": {
        "script": "build"
      }
    },
    "dev": {
      "executor": "nx:run-script",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "script": "dev"
      }
    },
    "start": {
      "executor": "nx:run-script",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "script": "start"
      }
    },
    "typecheck": {
      "executor": "nx:run-script",
      "cache": true,
      "dependsOn": ["typegen"],
      "options": {
        "script": "typecheck"
      }
    },
    "typegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "react-router typegen",
        "cwd": "apps/react-remix-example"
      }
    }
  },
  "tags": []
}
